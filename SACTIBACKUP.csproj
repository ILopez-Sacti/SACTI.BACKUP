<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Icono de marca para el .exe (Explorador, barra de tareas anclada, Panel de control). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- #1: solo recursos en espanol (quita idiomas de .NET y DevExpress que no se usan). -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- #2: solo los paquetes DevExpress que la app usa (editores + grid + skins).
         DevExpress.Win.Grid arrastra Navigation (XtraEditors/XtraBars), Printing, Utils,
         Data, Drawing, Images y skins. Se quitan Charts, Spreadsheet, RichEdit, Reports,
         Scheduler, Diagram, Map, Gauges, PivotGrid, etc. (no se usan). -->
    <PackageReference Include="DevExpress.Win.Grid" Version="22.2.3" />

	  <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />


	  
	  <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="9.*" />
	  <PackageReference Include="SharpZipLib" Version="1.*" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.*" />

  </ItemGroup>

  <ItemGroup>
    <!-- Plantilla del correo de notificacion: debe viajar junto al exe -->
    <Content Include="PlantillaCorreoSactiBackUp.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>